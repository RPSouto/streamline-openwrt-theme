#!/bin/sh

[ -n "${IPKG_INSTROOT:-}" ] && exit 0

if [ -f /etc/uci-defaults/30_luci-theme-streamline ]; then
	sh /etc/uci-defaults/30_luci-theme-streamline
	rm -f /etc/uci-defaults/30_luci-theme-streamline
fi

uci set luci.themes.Streamline='/luci-static/streamline'
uci set luci.main.mediaurlbase='/luci-static/streamline'
uci commit luci

rm -rf /tmp/luci-indexcache /tmp/luci-modulecache
exit 0
