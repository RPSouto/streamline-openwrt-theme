    {%
      let is_login = (blank_page || auth_fields || fuser != null || (!ctx.authsession && length(ctx.request_path) == 0));
      if (!is_login && !blank_page):
    %}
    </div>
    <footer>
      <span>Streamline · <a href="https://github.com/openwrt/luci" target="_blank" rel="noreferrer">{{ version.luciname }} {{ version.luciversion }}</a> / {{ version.distname }} {{ version.distversion }}</span>
      <ul class="breadcrumb pull-right" id="modemenu" style="display:none"></ul>
    </footer>
    <script>L.require('menu-streamline-v21')</script>
    {% endif %}
  </body>
</html>
