    {% if (!blank_page):
      let dist = version.distversion ?? '';
      if (version.distname && !match(dist, version.distname))
        dist = `${version.distname} ${dist}`;
    %}
    </div>
    <footer>
      <span>Streamline · {{ entityencode(dist) }}</span>
      <ul class="breadcrumb pull-right" id="modemenu" style="display:none"></ul>
    </footer>
    <script>L.require('menu-streamline-v21')</script>
    {% endif %}
  </body>
</html>
