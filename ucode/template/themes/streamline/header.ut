{# SPDX-License-Identifier: Apache-2.0 #}
{%
  import { getuid, getspnam } from 'luci.core';
  const boardinfo = ubus.call('system', 'board') ?? {};
  const rel = boardinfo.release ?? {};
  const dist = rel.distribution ? uc(rel.distribution) : 'OPENWRT';
  const major = match(rel.version, /^(\d+)/)?.[1];
  const brand_sub = major ? `${dist} ${major}` : (match(rel.version, /snapshot/i) ? `${dist} SNAPSHOT` : dist);
  http.prepare_content('text/html; charset=UTF-8');
-%>
<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}" data-darkmode="true">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#111331">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="darkreader-lock">
    <title>{{ striptags(`${boardinfo.hostname ?? '?'}${dispatched?.title ? ` | ${_(dispatched.title)}` : ''}`) }}</title>
    <script>(function(){try{var d=document.documentElement,p=localStorage.getItem('streamline.palette'),f=localStorage.getItem('streamline.font'),c={glinet:'#111331',streamline:'#0b0e14',ocean:'#071521',forest:'#0a1511',sunset:'#17100f',rose:'#180f18',oled:'#000000',light:'#f8fafc'},fonts={system:1,arial:1,serif:1,mono:1};if(!Object.prototype.hasOwnProperty.call(c,p))p='glinet';if(!Object.prototype.hasOwnProperty.call(fonts,f))f='system';d.setAttribute('data-palette',p);d.setAttribute('data-font',f);document.querySelector('meta[name="theme-color"]').setAttribute('content',c[p])}catch(e){}window.Streamline=window.Streamline||{version:'1.0.59-1',addons:{},protocols:{},routerProfiles:{},classifiers:[],customWidgets:[],registerAddon:function(i,d){if(!i||typeof d!=='object')return;this.addons[i]=d;if(d.protocols)Object.assign(this.protocols,d.protocols);if(d.routerProfiles)Object.assign(this.routerProfiles,d.routerProfiles);if(Array.isArray(d.classifiers))this.classifiers.push.apply(this.classifiers,d.classifiers);if(Array.isArray(d.widgets))this.customWidgets.push.apply(this.customWidgets,d.widgets);if(typeof d.init==='function'){try{d.init(this)}catch(e){}}},registerRouterProfile:function(k,p){if(k&&p)this.routerProfiles[k]=p},registerProtocol:function(k,p){if(k&&p)this.protocols[k]=p},getProtocol:function(n){return this.protocols[n]||null},getRouterProfile:function(b,m){var k=String(b||'').toLowerCase(),o=String(m||'').toLowerCase();for(var p in this.routerProfiles){var t=p.toLowerCase();if((k&&k.indexOf(t)!==-1)||(o&&o.indexOf(t)!==-1))return this.routerProfiles[p]}return null},simulateUpdate:function(v){try{localStorage.setItem('streamline.update_info',JSON.stringify({checkedAt:Date.now(),latestVersion:v||'v9.9.9',htmlUrl:'https://github.com/RPSouto/streamline-openwrt-theme/releases/latest',hasUpdate:true}));location.reload()}catch(e){}},clearUpdateCheck:function(){try{localStorage.removeItem('streamline.update_info');location.reload()}catch(e){}}};})()</script>
    <link rel="stylesheet" href="{{ media }}/cascade.css?v=1.0.59.1">
    <link rel="stylesheet" href="{{ media }}/mobile.css?v=1.0.59.1" media="(max-width: 991px), (max-height: 550px) and (orientation: landscape)">
    <link rel="icon" href="{{ media }}/logo-glinet.svg?v=1.0.59.1" sizes="any">
    <script>if(document.documentElement.getAttribute('data-palette')!=='glinet')document.querySelector('link[rel~="icon"]').href='{{ media }}/logo.svg?v=1.0.59.1'</script>
    <link rel="manifest" href="{{ media }}/manifest.json?v=1.0.59.1">
    {% if (dispatched?.css): %}<link rel="stylesheet" href="{{ resource }}/{{ dispatched.css }}">{% endif %}
    {% if (css): %}<style>{{ css }}</style>{% endif %}
    <script src="{{ dispatcher.build_url('admin/translations', dispatcher.lang) }}"></script>
    <script src="{{ resource }}/cbi.js"></script>
    <script defer src="{{ media }}/pwa.js?v=1.0.59.1"></script>
    <script defer src="{{ media }}/dashboard.js?v=1.0.59.1"></script>
    {%
      let _fs = require("fs");
      let _addons = _fs.glob("/www/luci-static/resources/streamline-addons/*.js");
      if (_addons) {
        for (let _a in _addons) {
    %}
    <script defer src="{{ resource }}/streamline-addons/{{ _fs.basename(_a) }}?v=1.0.59.1"></script>
    {%
        }
      }
    %}
  </head>
  <body class="lang_{{ dispatcher.lang }}{{ blank_page ? ' login-page' : '' }}" data-page="{{ entityencode(join('-', length(ctx.request_path) ? ctx.request_path : ctx.path), true) }}">
    {% if (!blank_page): %}
    <div class="mobile-bar">
      <button type="button" class="mobile-toggle" aria-label="{{ _('Toggle navigation') }}" aria-expanded="false">&#9776;</button>
      <a class="mobile-brand" href="/" data-sub="{{ entityencode(brand_sub) }}"><span>{{ striptags(boardinfo.hostname ?? '?') }}</span></a>
    </div>
    <header>
      <a class="brand" href="/" data-sub="{{ entityencode(brand_sub) }}"><span>{{ striptags(boardinfo.hostname ?? '?') }}</span></a>
      <ul class="nav" id="topmenu" style="display:none"></ul>
      <div id="indicators" class="pull-right"></div>
    </header>
    <div id="maincontent" class="container">
      {% if (getuid() == 0 && getspnam('root')?.pwdp === ''): %}
      <div class="alert-message warning">
        <h4>{{ _('No password set!') }}</h4>
        <p>{{ _('There is no password set on this router. Please configure a root password to protect the web interface.') }}</p>
        {% if (dispatcher.lookup('admin/system/admin')): %}
        <div class="right"><a class="btn" href="{{ dispatcher.build_url('admin/system/admin') }}">{{ _('Go to password configuration...') }}</a></div>
        {% endif %}
      </div>
      {% endif %}
      {% if (boardinfo.rootfs_type == 'initramfs'): %}
      <div class="alert-message warning">
        <h4>{{ _('System running in recovery (initramfs) mode.') }}</h4>
        <p>{{ _('No changes to settings will be stored and are lost after rebooting. This mode should only be used to install a firmware upgrade') }}</p>
      </div>
      {% endif %}
      <noscript><div class="alert-message warning"><h4>{{ _('JavaScript required!') }}</h4><p>{{ _('You must enable JavaScript in your browser or LuCI will not work properly.') }}</p></div></noscript>
      <div id="tabmenu" style="display:none"></div>
    {% endif %}
