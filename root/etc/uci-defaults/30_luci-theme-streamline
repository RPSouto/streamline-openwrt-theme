#!/bin/sh

changed=0

if ! uci -q get luci.themes.Streamline >/dev/null 2>&1; then
	uci set luci.themes.Streamline='/luci-static/streamline'
	changed=1
fi

if [ "${PKG_UPGRADE:-0}" != 1 ] && [ "$changed" = 1 ]; then
	uci set luci.main.mediaurlbase='/luci-static/streamline'
fi

[ "$changed" = 1 ] && uci commit luci
exit 0
